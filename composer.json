{
  "name": "furshield/backend",
  "type": "project",
  "description": "FurShield pet care management backend",
  "require": {"php": "^8.3", "laravel/framework": "^13.0", "laravel/sanctum": "^4.0"},
  "require-dev": {"fakerphp/faker": "^1.24", "laravel/pint": "^1.24", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.0", "pestphp/pest": "^4.0", "pestphp/pest-plugin-laravel": "^4.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {"test":"php artisan test", "format":"vendor/bin/pint"},
  "minimum-stability": "stable", "prefer-stable": true
}
